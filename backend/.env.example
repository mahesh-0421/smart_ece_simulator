# Environment Configuration for Smart ECE Lab Backend
# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Compiler and Simulation tool paths (Optional overrides; auto-detected if not specified)
# OCTAVE_PATH="C:\\Program Files\\GNU Octave\\Octave-11.3.0\\mingw64\\bin\\octave-cli.exe"
# IVERILOG_PATH="C:\\iverilog\\bin\\iverilog.exe"
# VVP_PATH="C:\\iverilog\\bin\\vvp.exe"

# Security & Execution limits
MAX_EXECUTION_TIME_SECONDS=15
MAX_SOURCE_CODE_SIZE_BYTES=65536
MAX_OUTPUT_SIZE_BYTES=262144

# Database
DATABASE_URL="sqlite:///./smart_ece_lab.db"

# Optional AI Error Debugger Provider (Works seamlessly offline if not configured)
AI_PROVIDER="" # Options: "gemini", "openai", "" (offline deterministic only)
AI_API_KEY=""
AI_MODEL=""
